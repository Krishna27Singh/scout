# Runtime environment and application logging.
APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL 17 with pgvector. Use postgresql:// or postgres:// URLs for
# managed PostgreSQL providers; Scout normalizes them to psycopg v3.
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# GitHub GraphQL API token for issue ingestion and Tier-2 JIT hydration.
GITHUB_TOKEN=

# ONNX embedding model and local model cache. FastEmbed downloads lazily.
EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
INGESTION_MAX_ISSUES_PER_REPO=120
CLOSED_ISSUE_RETENTION_DAYS=14
ON_DEMAND_REPO_RETENTION_DAYS=30

# Optional provider keys. Without either key, Scout uses deterministic local
# planning and grounded result summaries.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20

# Tier-2 JIT hydration limits for explicitly requested orgs/repositories.
JIT_HYDRATION_MAX_ISSUES=60
JIT_HYDRATION_MAX_ORG_REPOS=3
JIT_HYDRATION_STALE_HOURS=24
