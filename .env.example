# Runtime environment and application logging.
APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL 17 with pgvector. Use postgresql:// or postgres:// URLs for
# managed PostgreSQL providers; Scout normalizes them to psycopg v3.
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# Embedding dimensions reserved for the Phase 2 ingestion pipeline.
EMBEDDING_DIM=384

# Optional in Phase 1; used by the Phase 2 GitHub issue ingestion pipeline.
GITHUB_TOKEN=

# LLM configuration reserved for later conversational matching phases.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
