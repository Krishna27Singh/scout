# Runtime environment and application logging.
APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL 17 with pgvector. Use postgresql:// or postgres:// URLs for
# managed PostgreSQL providers; Scout normalizes them to psycopg v3.
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# GitHub GraphQL API token used by Phase 2 ingestion. Fine-grained public read
# access is sufficient; leave blank when not running ingestion.
GITHUB_TOKEN=

# ONNX embedding model and local model cache. FastEmbed downloads lazily.
EMBEDDING_DIM=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
INGESTION_MAX_ISSUES_PER_REPO=120
CLOSED_ISSUE_RETENTION_DAYS=14
ON_DEMAND_REPO_RETENTION_DAYS=30

# LLM configuration reserved for later conversational matching phases.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
